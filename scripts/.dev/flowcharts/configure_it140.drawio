y="1125" width="560" height="105" as="geometry" /></mxCell><mxCell id="d2" value="CVD / Xfce profile?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="755" y="1285" width="290" height="150" as="geometry" /></mxCell><mxCell id="c1" value="Repair existing Visual Studio Code desktop launcher to open ~/Repos; do not create a duplicate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="1305" width="520" height="100" as="geometry" /></mxCell><mxCell id="d3" value="Windows bare metal profile?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="755" y="1490" width="290" height="150" as="geometry" /></mxCell><mxCell id="w1" value="Create/repair course-owned “Visual Studio Code - IT 140” shortcut&#10;to open ~/Repos; preserve unrelated VS Code shortcuts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="1510" width="520" height="110" as="geometry" /></mxCell><mxCell id="p4" value="Post-validate managed user state, including repository workspace integrations and profile-owned IDE launch behavior" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="625" y="1720" width="550" height="100" as="geometry" /></mxCell><mxCell id="sum" value="Display configuration summary, log path, and Verify next step" style="shape=display;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1865" width="500" height="85" as="geometry" /></mxCell><mxCell id="end" value="End Configure" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="1995" width="260" height="70" as="geometry" /></mxCell><mxCell id="note" value="Repository workspace ownership boundary: automation manages only the existence of ~/Repos plus course-owned desktop-integration metadata. It MUST NOT recursively repair permissions, inspect repositories for maintenance, rewrite Git metadata, move/delete files, or otherwise mutate student work beneath ~/Repos." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1190" y="520" width="600" height="270" as="geometry" /></mxCell><mxCell id="note2" value="Visual treatment adapter:&#10;• CVD/Xfce: required native “development” emblem.&#10;• Windows: remove only stale course-managed application-icon metadata and retain the normal folder appearance; Desktop Repos uses the File Explorer/folder icon.&#10;• Ubuntu GNOME: development/code metadata when safely supported.&#10;• macOS: NOT APPLICABLE." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1190" y="860" width="600" height="290" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="s" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCe