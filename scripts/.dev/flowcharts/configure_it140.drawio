<mxfile host="app.diagrams.net" modified="2026-08-07T14:44:00.000Z" agent="IT 140 Engineering" version="24.7.17" type="device"><diagram id="configure_ide" name="IT 140 Configure Lifecycle Flowchart"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2100" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="IT 140 Configure Lifecycle Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="40" width="1500" height="40" as="geometry" /></mxCell><mxCell id="meta" value="Artifact version 0.6.0 | Version DTG 2026-08-07-10-44 | ISO 5807-style system flowchart | Black/white only" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="82" width="1700" height="30" as="geometry" /></mxCell><mxCell id="s" value="Start Configure" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="130" width="260" height="70" as="geometry" /></mxCell><mxCell id="p1" value="Parse options; start private log; validate platform/profile/manifest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="245" width="480" height="85" as="geometry" /></mxCell><mxCell id="p2" value="Validate required system layer and acquire current-user mutation lock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="375" width="480" height="85" as="geometry" /></mxCell><mxCell id="p3" value="Repair course-managed PATH and user tool prerequisites" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="505" width="440" height="80" as="geometry" /></mxCell><mxCell id="r1" value="Ensure ~/Repos exists as a directory&#10;(do not recurse into its contents)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="625" width="460" height="90" as="geometry" /></mxCell><mxCell id="d1" value="Does ~/Repos conflict with a non-directory object?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="770" width="360" height="180" as="geometry" /></mxCell><mxCell id="fail" value="FAIL without replacing the user object; report remediation" style="shape=display;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="815" width="390" height="95" as="geometry" /></mxCell><mxCell id="r2" value="Apply platform repository-workspace visual marker adapter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="1010" width="460" height="85" as="geometry" /></mxCell><mxCell id="r3" value="Create/repair Desktop Repos shortcut or symbolic link" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="1140" width="460" height="85" as="geometry" /></mxCell><mxCell id="p4" value="Configure GitHub identity, Git defaults, venv/packages, extensions, VS Code settings and file associations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="1270" width="560" height="105" as="geometry" /></mxCell><mxCell id="d2" value="CVD / Xfce profile?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="755" y="1435" width="290" height="150" as="geometry" /></mxCell><mxCell id="c1" value="Repair existing Visual Studio Code desktop launcher to open ~/Repos; do not create a duplicate launcher" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250" y="1460" width="510" height="100" as="geometry" /></mxCell><mxCell id="p5" value="Post-validate managed user state, including repository workspace integrations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1645" width="500" height="90" as="geometry" /></mxCell><mxCell id="sum" value="Display configuration summary, log path, and Verify next step" style="shape=display;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1780" width="500" height="85" as="geometry" /></mxCell><mxCell id="end" value="End Configure" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="1910" width="260" height="70" as="geometry" /></mxCell><mxCell id="note" value="Repository workspace ownership boundary: automation manages only the existence of ~/Repos plus course-created icon/emblem and desktop-link metadata. It MUST NOT recursively repair permissions, inspect repositories for maintenance, rewrite Git metadata, move/delete files, or otherwise mutate student work beneath ~/Repos." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1190" y="605" width="600" height="285" as="geometry" /></mxCell><mxCell id="note2" value="Visual marker adapter:&#10;• CVD/Xfce: required native GIO emblem “development”.&#10;• Ubuntu GNOME: development/code folder metadata when supported; warning/N/A otherwise.&#10;• Windows: Explorer desktop.ini folder icon using installed VS Code icon when available.&#10;• macOS: N/A; no supported built-in Finder emblem CLI is required." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1190" y="940" width="600" height="270" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="s" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1