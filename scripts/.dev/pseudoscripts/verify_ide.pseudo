# ==============================================================================
# IT 140 VERIFY PSEUDOSCRIPT
# ==============================================================================
#
# Repository path:
#     scripts/.dev/pseudoscripts/verify_ide.pseudo
#
# Purpose:
#     Inspect the supported system and current-user course layers without
#     installing, updating, removing, repairing, or rewriting managed state.
#
# Artifact version:
#     0.5.0
#
# Version date-time group-time group:
#     2026-08-01-10-43
#
# Development status:
#     Alpha Testing
#
# Version basis:
#     Version 0.1.0 represents the initial pseudoscript baseline.
#     Version 0.2.0 adopts SemVer metadata and manifest schema 2.0.
#     Version 0.4.0 adds the common CVD course-continuity conclusion.
#     Version 0.5.0 adopts minute-resolution version date-time group-time groups and
#     profile-aware lifecycle transition reporting.
#
# CVD implementation target:
#     verify_ide.sh version 2026.07.26.4 (legacy calendar version)
#
# Repository baseline:
#     GC-STEM/it140 commit ffc0c98dc405daff52caa9e61c2f9c5f65b3ebb4
#
# Manifest compatibility:
#     Requires schema_version 2.0, a strict SemVer automation_release,
#     and automation_release_date_time_group in YYYY-MM-DD-HH-MM format.
#
# SRS traceability:
#     VER-FR-001 through VER-FR-014; PKG-FR-021
#
# SDD traceability:
#     VER-DES-001 through VER-DES-014; INT-DES-014; ERR-DES-014
#
# Intended user:
#     Students, faculty, course support, or technical support.
#
# State boundary:
#     READ_ONLY_SYSTEM_AND_USER_OBSERVATION
#
# Permitted file creation:
#     - The required private transcript
#     - An explicitly requested and confirmed sanitized support bundle
#
# Explicit exclusions:
#     - Administrative privilege
#     - Repairing or changing a failed check
#     - Course work, repositories, Git history, credentials, or browser data
#
# ==============================================================================


artifact_version = "0.5.0"
version_date_time_group = "2026-08-01-10-43"
development_status = "Alpha Testing"
action_id = "verify"
workflow_context = resolve_manifest_workflow_context_read_only()
may_change_state = FALSE
lock_required = FALSE
required_options = [
    "help",
    "version",
    "noninteractive",
    "deployment_profile",
    "support_bundle",
    "yes",
    "skip_network"
]


# ==============================================================================
# 1. MAIN PROCEDURE
# ==============================================================================

PROCEDURE main(arguments)

    options = parse_supported_options_before_logging(arguments, required_options)

    IF options.help_requested
        display_verify_help()
        RETURN 0
    ENDIF

    IF options.version_requested
        display_verify_version(
            artifact_version,
            version_date_time_group,
            development_status
        )
        RETURN 0
    ENDIF

    enable_strict_error_handling()
    set_private_default_file_permissions()

    run_context = resolve_verify_paths_and_start_private_transcript(
        filename_pattern = "verify_<platform>_<YYYYMMDD>_<HHMMSS>.log"
    )

    initialize counts:
        pass = 0
        warning = 0
        fail = 0
        not_applicable = 0

    initialize:
        manifest_failure = FALSE
        unsupported_failure = FALSE
        unique_remediations = []
        support_staging = NONE

    INSTALL cleanup handler for support_staging only

    DISPLAY opening information:
        script version
        version date-time group
        development status
        current user
        purpose
        log path
    DISPLAY NOTICE that verify never elevates privilege or repairs failures

    check_platform_context(run_context)

    IF controlled manifest or schema is missing
        RECORD fail for verify.manifest
        SET manifest_failure = TRUE
        PRINT summary and RETURN exit code 5
    ENDIF

    IF the generic manifest-validation runtime is unavailable
        RECORD fail for verify.manifest_runtime
        SET manifest_failure = TRUE
        PRINT summary and RETURN exit code 5
    ENDIF

    TRY
        manifest_release = validate_verify_manifest(run_context)
        RECORD pass for verify.manifest
    CATCH validation_failure
        RECORD fail for verify.manifest with sanitized validation detail
        SET manifest_failure = TRUE
        PRINT summary and RETURN exit code 5
    END TRY

    check_disk_and_network(run_context, options)
    check_system_layer(run_context)
    check_user_layer(run_context)
    check_managed_assets(run_context)
    create_optional_sanitized_support_bundle(run_context, options)

    exit_code = resolve_verify_exit_code()
    print_verification_summary(run_context, exit_code)
    RETURN exit_code

ENDPROCEDURE


# ==============================================================================
# 2. RESULT AND EXIT-CODE RULES
# ==============================================================================

PROCEDURE record_result(status, check_id, message, remediation = NONE)

    REQUIRE status is pass, warning, fail, or not_applicable
    DISPLAY "[STATUS] [check_id] message"
    INCREMENT the matching count

    IF status = fail AND remediation is not empty
        ADD remediation once to unique_remediations
    ENDIF

ENDPROCEDURE


PROCEDURE resolve_verify_exit_code()

    IF manifest_failure = TRUE
        RETURN 5
    ELSE IF unsupported_failure = TRUE
        RETURN 2
    ELSE IF fail count > 0
        RETURN 1
    ELSE
        RETURN 0
    ENDIF

ENDPROCEDURE


# ==============================================================================
# 3. PLATFORM AND MANIFEST
# ==============================================================================

PROCEDURE check_platform_context(run_context)

    IF execution is root or system administrator
        RECORD fail verify.user_context
    ELSE
        RECORD pass verify.user_context
    ENDIF

    IF operating-system facts cannot be read
        RECORD fail verify.platform
        SET unsupported_failure = TRUE
        RETURN
    ENDIF

    IF operating-system family and release match the implementation
        RECORD pass verify.os_release
    ELSE
        RECORD fail verify.os_release
        SET unsupported_failure = TRUE
    ENDIF

    IF architecture matches the implementation
        RECORD pass verify.architecture
    ELSE
        RECORD fail verify.architecture
        SET unsupported_failure = TRUE
    ENDIF

    IF required desktop-management interface is available
        RECORD pass verify.desktop
    ELSE
        RECORD fail verify.desktop
        SET unsupported_failure = TRUE
    ENDIF

ENDPROCEDURE


PROCEDURE validate_verify_manifest(run_context)

    RETURN validate_controlled_manifest_pair(
        run_context.manifest_path,
        run_context.schema_path,
        run_context.platform_id,
        run_context.deployment_profile_id,
        required_top_level_keys = [
            "schema_version",
            "automation_release",
            "automation_release_date_time_group",
            "policy",
            "platforms",
            "deployment_profiles",
            "provider_profiles",
            "managed_settings",
            "managed_assets",
            "logging"
        ]
    )

ENDPROCEDURE


# ==============================================================================
# 4. ENVIRONMENT CHECKS
# ==============================================================================

PROCEDURE check_disk_and_network(run_context, options)

    available_space = query_free_space_for_user_home()
    required_space = manifest_minimum_free_space()

    IF available_space meets required_space
        RECORD pass verify.disk_space
    ELSE
        RECORD fail verify.disk_space with user-owned cleanup remediation
    ENDIF

    IF options.skip_network = TRUE
        RECORD not_applicable verify.network
        RETURN
    ENDIF

    timeout = manifest_network_timeout()

    IF approved source-hosting endpoint responds within timeout
        RECORD pass verify.network
    ELSE
        RECORD warning verify.network
    ENDIF

ENDPROCEDURE


# ==============================================================================
# 5. SYSTEM-LAYER CHECKS
# ==============================================================================

PROCEDURE check_system_layer(run_context)

    FOR EACH manifest-required operating-system package
        IF native package database reports installed
            RECORD pass verify.package.<package>
        ELSE
            RECORD fail verify.package.<package> with update remediation
        ENDIF
    ENDFOR

    FOR EACH manifest-required system capability
        REQUIRE at least one declared executable
        QUERY availability of all required executable names

        WHEN the capability has a specific version rule
            QUERY and validate the version
        ENDWHEN

        IF capability is available and compliant
            RECORD pass verify.capability.<role> with sanitized version
        ELSE
            RECORD fail verify.capability.<role> with update remediation
        ENDIF
    ENDFOR

    FOR EACH required structured system integration
        REQUIRE it exists and passes its format validator
        RECORD pass or fail with update remediation
    ENDFOR

    # The tested CVD implementation checks its managed browser bookmark policy.

    check_optional_numlock_state(run_context)

ENDPROCEDURE


PROCEDURE check_optional_numlock_state(run_context)

    IF optional Num Lock tool is unavailable
        DISPLAY NOTICE that course work is unaffected
        RETURN
    ENDIF

    IF the effective user-over-system startup entry enables Num Lock
        RECORD pass verify.optional.numlock_persistence
    ELSE
        DISPLAY NOTICE that automatic Num Lock is optional and not blocking
    ENDIF

    IF no graphical session is active
        DISPLAY NOTICE that current Num Lock state cannot be checked
        RETURN
    ENDIF

    IF Num Lock is currently enabled
        RECORD pass verify.optional.numlock_session
    ELSE
        DISPLAY NOTICE that current Num Lock state is optional and not blocking
    ENDIF

ENDPROCEDURE


# ==============================================================================
# 6. USER-LAYER CHECKS
# ==============================================================================

PROCEDURE check_user_layer(run_context)

    REQUIRE course root and private log directory
    RECORD pass or fail verify.course_folders with configure remediation

    REQUIRE exact managed PATH block in both managed shell startup files
    RECORD pass or fail verify.user_path_files with configure remediation

    REQUIRE current process PATH includes:
        course virtual-environment executable directory
        matching platform student-script directory
    RECORD pass or fail verify.current_path
    REMEDIATION for current-path failure is to close this terminal, open a new
        terminal, and rerun verify

    REQUIRE usable course virtual environment
    RECORD pass or fail verify.virtual_environment with configure remediation

    FOR EACH manifest-required virtual-environment package
        RECORD pass or fail verify.user_tool.<package> with configure remediation
    ENDFOR

    FOR EACH manifest-required IDE extension
        RECORD pass or fail verify.extension.<role> with configure remediation
    ENDFOR

    REQUIRE valid source-hosting provider authentication
    RECORD pass or fail verify.provider_authentication with configure remediation

    REQUIRE nonempty Git display name
    RECORD pass or fail verify.git_display_name with configure remediation

    REQUIRE Git email matches provider-approved private noreply identity
    RECORD pass or fail verify.git_private_identity with configure remediation

    FOR EACH manifest-managed Git setting
        REQUIRE exact declared value
        RECORD pass or fail verify.git_setting.<key> with configure remediation
    ENDFOR

    REQUIRE the IDE settings object contains all managed settings, including the
        current course interpreter and course-root paths
    PRESERVE and ignore unrelated settings during comparison
    RECORD pass or fail verify.ide_settings with configure remediation

    REQUIRE course-folder and IDE desktop launchers
    RECORD pass or fail verify.desktop_launchers with configure remediation

    REQUIRE managed panel-launcher marker and launcher file
    RECORD pass or fail verify.panel_launcher with configure remediation

    FOR EACH student lifecycle script:
        config_<platform>
        update_<platform>
        verify_<platform>
        REQUIRE the script exists and is executable
        RECORD pass or fail verify.script_permissions.<script>
    ENDFOR

    DO NOT require bootstrap to be executable
    DO NOT inspect or require administrator master/setup in the student workflow

ENDPROCEDURE


# ==============================================================================
# 7. MANAGED-ASSET CHECKS
# ==============================================================================

PROCEDURE check_managed_assets(run_context)

    FOR EACH manifest-declared managed asset destination
        IF the destination is readable
            RECORD pass verify.asset.<asset_id>
        ELSE
            RECORD fail verify.asset.<asset_id> with update remediation
        ENDIF
    ENDFOR

ENDPROCEDURE


# ==============================================================================
# 8. OPTIONAL SANITIZED SUPPORT BUNDLE
# ==============================================================================

PROCEDURE create_optional_sanitized_support_bundle(run_context, options)

    IF options.support_bundle = FALSE
        RETURN
    ENDIF

    DISPLAY exact bundle inventory:
        sanitized verification log
        manifest and script release summary
        supported platform facts
        required capability version summary

    DISPLAY exclusions:
        course work
        repositories
        Git history
        credentials
        browser data

    IF options.noninteractive = TRUE AND options.yes = FALSE
        RECORD not_applicable verify.support_bundle
        RETURN
    ENDIF

    IF interactive confirmation has not already been supplied
        PROMPT for explicit confirmation
        IF declined
            RECORD not_applicable verify.support_bundle
            RETURN
        ENDIF
    ENDIF

    CREATE private support staging

    SANITIZE the transcript:
        replace provider private noreply identities
        replace user-specific home-directory names

    WRITE:
        release summary
        supported platform facts
        capability version summary
        exact inventory

    SCAN staged files for prohibited secret-like content

    IF the safety scan detects prohibited content
        REMOVE support staging
        RECORD fail verify.support_bundle_safety
        DO NOT create an archive
        RETURN
    ENDIF

    CREATE compressed archive in the private log directory
    SET archive permissions to current-user-only
    REMOVE support staging
    RECORD pass verify.support_bundle with archive path

ENDPROCEDURE


# ==============================================================================
# 9. SUMMARY
# ==============================================================================

PROCEDURE print_verification_summary(run_context, exit_code)

    IF exit_code = 0
        result = PASS
        course_readiness = READY
        IF warning count > 0
            next_step = review warning; no required failure detected
        ELSE
            next_step = course environment is ready for course work
        ENDIF
    ELSE
        result = FAIL
        course_readiness = ACTION_REQUIRED
        next_step = complete recommended action and rerun verify
    ENDIF

    DISPLAY:
        result
        course readiness
        pass count
        warning count
        fail count
        not-applicable count
        script version
        version date-time group
        development status
        manifest release
        elapsed time
        next step
        log path
        exit code

    IF unique_remediations is not empty
        DISPLAY each remediation once
    ENDIF

    IF exit_code is nonzero
        CALL display_course_continuity_guidance(run_context)
    ENDIF

    DISPLAY success or error conclusion
    DISPLAY closing log and fresh-terminal notices

ENDPROCEDURE
