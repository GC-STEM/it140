)

    prerequisite_results = new_result_collection()

    # Include only checks required before the action plan can be trusted.
    # Examples: release, architecture, disk, network, privilege, user context,
    # system-layer readiness, source availability, and managed-path safety.

    {{ACTION_SPECIFIC_PREREQUISITE_LOGIC}}

    RETURN prerequisite_results

ENDPROCEDURE


PROCEDURE build_action_plan(
    run_context,
    platform_facts,
    deployment_profile,
    manifest,
    adapters,
    prerequisite_results
)

    action_plan = create_empty_dependency_aware_plan()

    # Every plan item declares:
    # - stable operation_id
    # - dependencies
    # - read-only or mutating behavior
    # - privilege scope
    # - managed targets
    # - whether failure blocks dependents
    # - rollback or recovery behavior
    # - SRS and SDD traceability

    {{ACTION_SPECIFIC_QUERY_AND_PLAN_LOGIC}}

    validate_plan_against_action_boundaries(action_plan, state_scope)
    RETURN successful_plan_result(action_plan)

ENDPROCEDURE


PROCEDURE execute_action_stage(
    plan_stage,
    run_context,
    manifest,
    adapters
)

    stage_results = new_result_collection()

    # setup, configure, and update use query-plan-apply-verify.
    # verify uses query-and-report with read-only adapter interfaces.

    {{ACTION_SPECIFIC_STAGE_EXECUTION_LOGIC}}

    RETURN stage_results

ENDPROCEDURE


PROCEDURE post_validate_action(
    run_context,
    platform_facts,
    deployment_profile,
    manifest,
    adapters,
    changed_items
)

    post_validation_results = new_result_collection()

    {{ACTION_SPECIFIC_POST_VALIDATION_LOGIC}}

    RETURN post_validation_results

ENDPROCEDURE


# ==============================================================================
# 6. STANDARD EXIT-CODE RESOLUTION
# ==============================================================================
#
# Precedence is based on safety and remediation value, not numeric order:
#
#     5  invalid, corrupt, incompatible, or integrity-failed manifest or asset
#     2  unsupported invocation, platform, deployment, or OS release
#     3  required permission or privilege unavailable
#     4  approved external source or service unavailable after retries
#     7  partial completion or changed state requiring remediation
#     1  other required operation or check failure
#     6  required interactive operation canceled
#     0  all required work completed successfully
#

PROCEDURE resolve_standard_exit_code(run_summary)

    IF has_manifest_or_integrity_failure(run_summary)
        RETURN 5
    ELSE IF has_unsupported_condition(run_summary)
        RETURN 2
    ELSE IF has_required_privilege_failure(run_summary)
        RETURN 3
    ELSE IF has_exhausted_external_failure(run_summary)
        RETURN 4
    ELSE IF has_partial_completion(run_summary)
        RETURN 7
    ELSE IF has_other_required_failure(run_summary)
        RETURN 1
    ELSE IF has_required_cancellation(run_summary)
        RETURN 6
    ELSE
        RETURN 0
    ENDIF

ENDPROCEDURE


# ==============================================================================
# 7. REVIEW CRITERIA
# ==============================================================================
#
# Before approving an individual pseudoscript, confirm:
#
# - Every placeholder has been replaced.
# - The action, intended user, state scope, privilege, and exclusions are correct.
# - The common stages remain in the approved order.
# - Product and platform details come from the manifest.
# - No concrete platform commands or arbitrary executable strings appear.
# - Setup, configure, and update use query-plan-apply-verify.
# - Verify has only read access and records no managed change.
# - Dependencies use skipped_dependency instead of misleading secondary failures.
# - Mutating operations declare required locks, staging, and recovery behavior.
# - Paths are derived from approved context variables and canonicalized.
# - Logs use the home-derived ~/it140/logs/ location.
# - Output uses text labels and does not rely on color.
# - Long operations report truthful progress.
# - Secrets, full personal email addresses, and student files are excluded.
# - Cleanup and the final summary are attempted after handled failures.
# - Exit-code precedence matches the SDD.
# - Next-step and remediation guidance are explicit.
# - Major procedures and plan items include SRS and SDD traceability.
# - The design can be implemented equivalently on every enabled platform.
#
# ==============================================================================
# END OF TEMPLATE
# ==============================================================================
