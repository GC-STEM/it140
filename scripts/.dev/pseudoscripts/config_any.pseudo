# ==============================================================================
# IT 140 CONFIGURE PSEUDOSCRIPT
# ==============================================================================
#
# Repository path:
#     scripts/.dev/pseudoscripts/config_any.pseudo
#
#
# Purpose:
#     Establish or repair the current user's manifest-declared course environment.
#
# Artifact version:
#     2026.07.25.1
#
# Implementation release target:
#     2026.07.25.2
#
# SRS baseline:
#     IT140-SRS-SCRIPTS, version 2026.07.25.2
#
# SDD baseline:
#     IT140-SDD-SCRIPTS, version 2026.07.25.2
#
# Repository baseline:
#     GC-STEM/it140 commit fe777dec65167a197627b2f9507111b69f8ed73a
#
# Authority:
#     The SRS and SDD are authoritative. The controlled manifest selects
#     current products, versions, sources, platforms, deployment profiles,
#     provider rules, settings, paths, and managed assets.
#
# ==============================================================================


# ==============================================================================
# 1. DOCUMENT CONTROL
# ==============================================================================
#
# Artifact:
#     config_any.pseudo
#
# Lifecycle action:
#     configure
#
#
# Purpose:
#     Establish or repair the current user's manifest-declared course environment.
#
#
# Intended user:
#     The standard student or faculty account that will complete course work
#
# State boundary:
#     USER_SPECIFIC
#
#
# Mutation policy:
#     Change only current-user course folders, managed settings, required user tools,
#     authentication integration, and launchers
#
#
# Privilege policy:
#     Run as the intended standard user without system elevation
#
# SRS traceability:
#     CFG-FR-001 through CFG-FR-016
#     PKG-FR-001 through PKG-FR-020
#     PKG-NFR-001 through PKG-NFR-027
#     PKG-TC-001 through PKG-TC-009
#     PKG-QOS-001 through PKG-QOS-022
#     REF-TC-001 through REF-TC-007 where applicable
#
# SDD traceability:
#     CFG-DES-001 through CFG-DES-016
#     ARC-DES-001 through ARC-DES-010
#     DAT-DES-001 through DAT-DES-015
#     INT-DES-001 through INT-DES-012
#     SHR-DES-001 through SHR-DES-016
#     ERR-DES-001 through ERR-DES-012
#     SEC-DES-001 through SEC-DES-012
#     PLT-DES-001 through PLT-DES-011
#
#
# Preconditions:
#     - The matching setup script has established the required system layer.
#     - The script runs as the intended standard user.
#     - The approved manifest and schema are present and readable.
#
#
# Successful postconditions:
#     - Required user tools, settings, folders, and integrations are usable.
#     - Provider identity follows the approved privacy rule when configured.
#     - Optional extensions and unrelated valid settings are preserved.
#
#
# Explicit exclusions:
#     - Student source files and assignment repositories
#     - Student version-control history
#     - Secrets, authentication tokens, and browser session data
#     - Optional software and unrelated user settings
#     - System-wide package, repository, policy, and application changes
#     - Passwords, tokens, private keys, and provider credential-store contents
#     - Whole-file replacement of unrelated user settings
#
#
# Normal next step:
#     Run the matching verify script.
#
# ==============================================================================


# ==============================================================================
# 2. ACTION PROFILE
# ==============================================================================
#
# Action:
#     configure
#
# State scope:
#     current_user
#
# May change managed state:
#     TRUE
#
# Operation lock required:
#     TRUE
#
# Lock scope:
#     current_user_managed_settings_tools_and_integrations
#
# Privilege model:
#     standard user; reject unintended elevated context
#
# ==============================================================================

action_id = "configure"
state_scope = "current_user"
may_change_state = TRUE
lock_required = TRUE
normal_next_step = "verify"
lock_scope = "current_user_managed_settings_tools_and_integrations"

purpose_text = join_text([
    "Establish or repair the current user's manifest-declared course",
    "environment."
])
intended_user_text = join_text([
    "The standard student or faculty account that will complete",
    "course work"
])
privilege_policy_text = "Run as the intended standard user without system elevation"
help_prerequisites_text = join_text([
    "Completed system setup, intended standard account, and network",
    "access when provider authentication is required"
])
expected_interaction_text = join_text([
    "Provider authentication and display-name prompts may occur only",
    "when required."
])


# ==============================================================================
# 3. COMMON MAIN PROCEDURE
# ==============================================================================

PROCEDURE main(arguments)

    BEGIN STAGE "run.initialize"

        enable_strict_error_handling()
        install_interruption_handlers()

        run_context = create_minimal_run_context(
            action_id,
            script_version = "2026.07.25.2",
            supported_schema_range = "1.0"
        )

        run_summary = create_empty_run_summary()
        operation_lock = NONE
        transcript_started = FALSE

    ENDSTAGE


    BEGIN STAGE "run.options"

        option_result = parse_supported_options(
            arguments,
            allowed_options = [
                "help",
            "version",
            "noninteractive",
            "deployment_profile"
            ]
        )
        append_result(run_summary, option_result)

        IF option_result.status = fail
            record_invalid_invocation(run_summary)
            GOTO FINALIZE_RUN
        ENDIF

        options = option_result.value

    ENDSTAGE


    BEGIN STAGE "log.start"

        path_result = resolve_bootstrap_paths(
            run_context,
            course_root_rule = "${HOME}/it140",
            manifest_rule =
                "${HOME}/it140/scripts/.manifest/it140_manifest.json",
            schema_rule =
                "${HOME}/it140/scripts/.manifest/it140_manifest.schema.json"
        )
        append_result(run_summary, path_result)

        IF path_result.status = fail
            GOTO FINALIZE_WITHOUT_TRANSCRIPT
        ENDIF

        log_result = create_log_directory_and_start_transcript(
            run_context,
            filename_pattern =
                "<action>_<platform>_<YYYYMMDD>_<HHMMSS>.log"
        )
        append_result(run_summary, log_result)

        IF log_result.status = fail
            GOTO FINALIZE_WITHOUT_TRANSCRIPT
        ENDIF

        transcript_started = TRUE

    ENDSTAGE


    IF options.help_requested = TRUE

        display_help(
            purpose = purpose_text,
            intended_user = intended_user_text,
            prerequisites = help_prerequisites_text,
            log_location = run_context.log_directory,
            exit_code_meanings = standard_exit_code_catalog
        )

        append_success_result(run_summary, "run.help")
        GOTO FINALIZE_RUN

    ENDIF


    IF options.version_requested = TRUE

        display_version(
            script_version = run_context.script_version,
            supported_schema_range = run_context.supported_schema_range
        )

        append_success_result(run_summary, "run.version")
        GOTO FINALIZE_RUN

    ENDIF


    BEGIN STAGE "run.opening"

        display_opening_information(
            package_name = "IT 140 Course Automation Scripts",
            action_id = action_id,
            script_version = run_context.script_version,
            current_user_id = sanitized_current_user_id(),
            purpose = purpose_text,
            state_scope = state_scope,
            expected_privilege = privilege_policy_text,
            expected_interaction = expected_interaction_text,
            log_path = run_context.log_path
        )

        append_success_result(run_summary, "run.opening")

    ENDSTAGE


    BEGIN STAGE "platform.detect"

        platform_facts = detect_platform_facts()
        platform_result = validate_minimum_platform_facts(platform_facts)
        append_result(run_summary, platform_result)

        IF platform_result.status = fail
            record_unsupported_or_unreadable_platform(run_summary)
            GOTO FINALIZE_RUN
        ENDIF

    ENDSTAGE


    BEGIN STAGE "deployment.resolve"

        deployment_result = resolve_deployment_profile(
            platform_facts,
            explicit_approved_context = options.deployment_profile
        )
        append_result(run_summary, deployment_result)

        IF deployment_result.status = fail
            record_unsupported_deployment(run_summary)
            GOTO FINALIZE_RUN
        ENDIF

        deployment_profile = deployment_result.value
        run_context.deployment_profile_id = deployment_profile.profile_id

    ENDSTAGE


    BEGIN STAGE "platform.match"

        match_result = confirm_action_platform_match(
            action_id,
            expected_platform_id = platform_implementation_id(),
            platform_facts,
            deployment_profile
        )
        append_result(run_summary, match_result)

        IF match_result.status = fail
            record_unsupported_invocation(run_summary)
            GOTO FINALIZE_RUN
        ENDIF

    ENDSTAGE


    BEGIN STAGE "manifest.validate"

        manifest_result = load_and_validate_manifest(
            manifest_path = run_context.manifest_path,
            schema_path = run_context.schema_path,
            validation_layers = [
                file_validation,
                duplicate_key_validation,
                json_syntax_validation,
                schema_validation,
                semantic_validation,
                cross_reference_validation,
                deployment_profile_validation,
                adapter_allowlist_validation,
                path_boundary_validation,
                trust_and_integrity_validation,
                script_manifest_compatibility_validation,
                secret_and_personal_value_validation
            ]
        )
        append_result(run_summary, manifest_result)

        IF manifest_result.status = fail
            record_manifest_failure(run_summary)
            GOTO FINALIZE_RUN
        ENDIF

        manifest = freeze_validated_configuration(manifest_result.value)
        run_context.manifest_release = manifest.automation_release
        run_context.platform_id = deployment_profile.platform_id

        display_manifest_release(run_context.manifest_release)

    ENDSTAGE


    BEGIN STAGE "adapter.resolve"

        adapter_result = resolve_allowlisted_adapters(
            action_id,
            run_context.platform_id,
            run_context.deployment_profile_id,
            manifest
        )
        append_result(run_summary, adapter_result)

        IF adapter_result.status = fail
            record_unsupported_configuration(run_summary)
            GOTO FINALIZE_RUN
        ENDIF

        adapters = adapter_result.value

    ENDSTAGE


    BEGIN STAGE "boundary.validate"

        boundary_result = validate_action_boundaries(
            action_id,
            state_scope,
            may_change_state,
            adapters,
            manifest
        )
        append_result(run_summary, boundary_result)

        IF boundary_result.status = fail
            record_unsafe_design_or_configuration(run_summary)
            GOTO FINALIZE_RUN
        ENDIF

    ENDSTAGE


    IF lock_required = TRUE

        BEGIN STAGE "lock.acquire"

            lock_result = acquire_operation_lock(
                action_id,
                run_context.platform_id,
                managed_resource_scope = lock_scope
            )
            append_result(run_summary, lock_result)

            IF lock_result.status = fail
                record_concurrent_operation_failure(run_summary)
                GOTO FINALIZE_RUN
            ENDIF

            operation_lock = lock_result.value

        ENDSTAGE

    ENDIF


    BEGIN STAGE "configure.prerequisites"

        prerequisite_results = run_action_prerequisites(
            run_context,
            platform_facts,
            deployment_profile,
            manifest,
            adapters
        )
        append_results(run_summary, prerequisite_results)

        IF has_blocking_required_failure(prerequisite_results)
            mark_dependent_operations_skipped(run_summary)
            GOTO FINALIZE_RUN
        ENDIF

    ENDSTAGE


    BEGIN STAGE "configure.plan"

        plan_result = build_action_plan(
            run_context,
            platform_facts,
            deployment_profile,
            manifest,
            adapters,
            prerequisite_results,
            options
        )
        append_result(run_summary, plan_result)

        IF plan_result.status = fail
            record_planning_failure(run_summary)
            GOTO FINALIZE_RUN
        ENDIF

        action_plan = plan_result.value
        display_sanitized_plan_summary(action_plan)

    ENDSTAGE


    BEGIN STAGE "configure.execute"

        FOR EACH plan_stage IN action_plan.stages IN dependency_order

            IF required_dependency_failed(plan_stage, run_summary)

                stage_result = create_skipped_dependency_result(plan_stage)
                append_result(run_summary, stage_result)
                display_stage_result(stage_result)
                CONTINUE

            ENDIF

            TRY

                stage_results = execute_action_stage(
                    plan_stage,
                    run_context,
                    manifest,
                    adapters,
                    options
                )

            CATCH user_cancellation

                stage_results = create_canceled_result(
                    plan_stage.operation_id,
                    remediation_owner = "configure"
                )

            CATCH temporary_external_failure

                stage_results = retry_with_manifest_policy(
                    plan_stage,
                    manifest.policy.retry_profiles,
                    adapters
                )

            CATCH handled_operation_failure

                stage_results = create_handled_failure_result(
                    plan_stage.operation_id,
                    sanitized_error()
                )

            CATCH unexpected_failure

                stage_results = create_unexpected_failure_result(
                    plan_stage.operation_id,
                    sanitized_error()
                )

            END TRY

            append_results(run_summary, stage_results)
            display_stage_results(stage_results)

        ENDFOR

    ENDSTAGE


    IF may_change_state = TRUE AND run_summary.changed_items IS NOT EMPTY

        BEGIN STAGE "configure.post_validate"

            post_validation_results = post_validate_action(
                run_context,
                platform_facts,
                deployment_profile,
                manifest,
                adapters,
                run_summary.changed_items
            )
            append_results(run_summary, post_validation_results)

            IF has_required_failure(post_validation_results)
                record_partial_or_failed_final_state(run_summary)
            ENDIF

        ENDSTAGE

    ENDIF


    IF action_id = "verify"

        BEGIN STAGE "verify.read_only_assertion"

            read_only_result = confirm_no_managed_state_changed(run_summary)
            append_result(run_summary, read_only_result)

            IF read_only_result.status = fail
                record_critical_design_failure(run_summary)
            ENDIF

        ENDSTAGE

    ENDIF


FINALIZE_RUN:

    BEGIN STAGE "run.finalize"

        restart_result = determine_restart_guidance(
            run_context,
            platform_facts,
            deployment_profile,
            run_summary
        )
        append_result(run_summary, restart_result)

        run_summary.remediation = determine_remediation(run_summary)
        run_summary.next_step = determine_next_step(
            action_id,
            normal_next_step,
            run_summary
        )

    ENDSTAGE


    BEGIN STAGE "run.cleanup"

        cleanup_results = remove_private_temporary_data()
        append_results_without_overriding_primary_failure(
            run_summary,
            cleanup_results
        )

        IF operation_lock IS NOT NONE

            release_result = release_operation_lock(operation_lock)
            append_result_without_overriding_primary_failure(
                run_summary,
                release_result
            )

        ENDIF

    ENDSTAGE


    run_summary.final_exit_code = resolve_standard_exit_code(run_summary)
    run_summary.elapsed_time = calculate_elapsed_time(run_context.start_time)


    BEGIN STAGE "run.summary"

        display_final_summary(
            overall_result = determine_overall_result(run_summary),
            changed_items = run_summary.changed_items,
            warnings = run_summary.warnings,
            failures = run_summary.failures,
            restart_guidance = run_summary.restart_guidance,
            remediation = run_summary.remediation,
            next_step = run_summary.next_step,
            log_path = run_context.log_path,
            exit_code = run_summary.final_exit_code
        )

    ENDSTAGE


    IF transcript_started = TRUE
        close_transcript()
    ENDIF

    RETURN run_summary.final_exit_code


FINALIZE_WITHOUT_TRANSCRIPT:

    minimal_exit_code = resolve_standard_exit_code(run_summary)
    display_minimum_safe_summary(run_summary, minimal_exit_code)
    RETURN minimal_exit_code

ENDPROCEDURE


# ==============================================================================
# 4. CONFIGURE-SPECIFIC PROCEDURES
# ==============================================================================

PROCEDURE run_action_prerequisites(
    run_context,
    platform_facts,
    deployment_profile,
    manifest,
    adapters
)

    results = new_result_collection()

    append_result(
        results,
        confirm_intended_standard_user_context(platform_facts)
    )

    append_result(
        results,
        reject_root_or_system_administrator_execution(
            platform_facts,
            allowed_exception = NONE
        )
    )

    append_results(
        results,
        probe_required_system_layer(
            manifest,
            deployment_profile.platform_id,
            adapters.read_only_capabilities,
            remediation_owner = "setup"
        )
    )

    append_result(
        results,
        check_home_derived_course_paths(run_context)
    )

    append_result(
        results,
        check_user_write_access_to_managed_paths(run_context, manifest)
    )

    append_result(
        results,
        validate_provider_profiles_needed_for_configuration(manifest)
    )

    append_result(
        results,
        check_required_network_reachability(
            manifest,
            purpose = "provider authentication when required",
            allow_not_needed_when_authenticated = TRUE
        )
    )

    append_result(
        results,
        confirm_no_system_scope_adapter_methods_are_available(adapters)
    )

    RETURN results

ENDPROCEDURE


PROCEDURE build_action_plan(
    run_context,
    platform_facts,
    deployment_profile,
    manifest,
    adapters,
    prerequisite_results,
    options
)

    action_plan = create_empty_dependency_aware_plan()

    folder_plan = compare_course_folder_state(
        run_context,
        manifest.policy
    )
    add_plan_stage(
        action_plan,
        operation_id = "configure.course_folders",
        operation_type = "create_or_repair_course_folders",
        dependencies = [],
        planned_items = folder_plan,
        mutating = TRUE,
        privilege_scope = "none",
        managed_targets = folder_plan.targets,
        blocks_dependents = TRUE,
        recovery = "preserve existing folder contents",
        traceability = ["CFG-FR-003", "CFG-FR-012",
                        "CFG-DES-003", "CFG-DES-012"]
    )

    path_plan = compare_user_executable_path_state(
        run_context,
        platform_implementation_script_directory(),
        manifest
    )
    add_plan_stage(
        action_plan,
        operation_id = "configure.user_path",
        operation_type = "merge_user_executable_path",
        dependencies = ["configure.course_folders"],
        planned_items = path_plan,
        mutating = TRUE,
        privilege_scope = "none",
        managed_targets = path_plan.targets,
        blocks_dependents = FALSE,
        recovery = "restore previous valid managed entry",
        traceability = ["CFG-FR-004", "CFG-FR-015",
                        "CFG-DES-004", "CFG-DES-015"]
    )

    provider_plan = build_provider_authentication_and_identity_plan(
        manifest.provider_profiles,
        adapters.providers
    )
    add_plan_stage(
        action_plan,
        operation_id = "configure.provider_identity",
        operation_type = "authenticate_and_config_identity",
        dependencies = ["configure.course_folders"],
        planned_items = provider_plan,
        mutating = TRUE,
        privilege_scope = "none",
        managed_targets = provider_plan.identity_setting_targets,
        blocks_dependents = TRUE,
        recovery = "leave provider credentials in provider-owned store",
        traceability = ["CFG-FR-005", "CFG-FR-006",
                        "CFG-FR-007", "CFG-FR-008",
                        "CFG-DES-005", "CFG-DES-006",
                        "CFG-DES-007", "CFG-DES-008"]
    )

    version_control_plan = compare_managed_version_control_settings(
        manifest.managed_settings,
        adapters.version_control
    )
    add_plan_stage(
        action_plan,
        operation_id = "configure.version_control",
        operation_type = "merge_version_control_settings",
        dependencies = ["configure.provider_identity"],
        planned_items = version_control_plan,
        mutating = TRUE,
        privilege_scope = "none",
        managed_targets = version_control_plan.targets,
        blocks_dependents = FALSE,
        recovery = "restore prior managed values when available",
        traceability = ["CFG-FR-009", "CFG-FR-015",
                        "CFG-DES-009", "CFG-DES-015"]
    )

    user_tool_plan = compare_required_user_tool_state(
        manifest,
        deployment_profile.platform_id,
        adapters.capabilities
    )
    add_plan_stage(
        action_plan,
        operation_id = "configure.user_tools",
        operation_type = "install_or_repair_user_tools",
        dependencies = ["configure.course_folders"],
        planned_items = user_tool_plan,
        mutating = TRUE,
        privilege_scope = "none",
        managed_targets = user_tool_plan.targets,
        blocks_dependents = TRUE,
        recovery = "adapter-defined user-scope repair",
        traceability = ["CFG-FR-010", "CFG-FR-015",
                        "CFG-DES-010", "CFG-DES-015"]
    )

    ide_settings_plan = compare_managed_ide_settings(
        manifest.managed_settings,
        adapters.ide
    )
    add_plan_stage(
        action_plan,
        operation_id = "configure.ide_settings",
        operation_type = "merge_managed_ide_settings",
        dependencies = ["configure.user_tools"],
        planned_items = ide_settings_plan,
        mutating = TRUE,
        privilege_scope = "none",
        managed_targets = ide_settings_plan.targets,
        blocks_dependents = FALSE,
        recovery = "preserve original file and restore staged backup",
        traceability = ["CFG-FR-011", "CFG-FR-015",
                        "CFG-DES-011", "CFG-DES-015",
                        "ERR-DES-009"]
    )

    integration_plan = compare_user_integration_state(
        manifest,
        deployment_profile,
        adapters.platform
    )
    add_plan_stage(
        action_plan,
        operation_id = "configure.user_integrations",
        operation_type = "create_or_repair_user_integrations",
        dependencies = ["configure.course_folders",
                        "configure.user_tools"],
        planned_items = integration_plan,
        mutating = TRUE,
        privilege_scope = "none",
        managed_targets = integration_plan.targets,
        blocks_dependents = FALSE,
        recovery = "restore previous declared integration",
        traceability = ["CFG-FR-013", "CFG-FR-015",
                        "CFG-DES-013", "CFG-DES-015"]
    )

    permission_plan = compare_script_permission_state(
        platform_implementation_script_directory(),
        manifest
    )
    add_plan_stage(
        action_plan,
        operation_id = "configure.script_permissions",
        operation_type = "repair_user_executable_permissions",
        dependencies = ["configure.course_folders"],
        planned_items = permission_plan,
        mutating = TRUE,
        privilege_scope = "none",
        managed_targets = permission_plan.targets,
        blocks_dependents = FALSE,
        recovery = "restore prior permissions when available",
        traceability = ["CFG-FR-014", "CFG-DES-014"]
    )

    assert_plan_contains_only_current_user_scope_operations(action_plan)
    validate_plan_against_action_boundaries(action_plan, state_scope)

    RETURN successful_plan_result(action_plan)

ENDPROCEDURE


PROCEDURE execute_action_stage(
    plan_stage,
    run_context,
    manifest,
    adapters,
    options
)

    IF plan_stage.operation_type =
        "authenticate_and_config_identity"

        RETURN execute_provider_identity_stage(
            plan_stage,
            run_context,
            manifest,
            adapters,
            options
        )

    ENDIF

    IF plan_stage.operation_type = "merge_managed_ide_settings"

        RETURN execute_validated_settings_merge(
            plan_stage,
            manifest,
            adapters.ide
        )

    ENDIF

    results = new_result_collection()

    FOR EACH plan_item IN plan_stage.planned_items

        current_state = query_plan_item_state(plan_item, adapters)

        IF state_satisfies_rule(current_state, plan_item.expected_rule)

            append_result(
                results,
                create_unchanged_result(
                    plan_item.operation_id,
                    sanitized_detail = current_state.summary
                )
            )
            CONTINUE

        ENDIF

        validate_user_input_fields(plan_item)
        validate_managed_targets(plan_item.managed_targets, manifest)

        operation_result = apply_smallest_approved_user_change(
            plan_item,
            adapters
        )
        append_result(results, operation_result)

        IF operation_result.status = fail
            CONTINUE
        ENDIF

        final_state = query_plan_item_state(plan_item, adapters)
        append_result(
            results,
            compare_final_state(plan_item, final_state)
        )

    ENDFOR

    RETURN results

ENDPROCEDURE


PROCEDURE execute_provider_identity_stage(
    plan_stage,
    run_context,
    manifest,
    adapters,
    options
)

    results = new_result_collection()
    provider_profile = plan_stage.planned_items.provider_profile
    provider_adapter = adapters.providers[provider_profile.adapter_id]

    auth_status = provider_adapter.get_authentication_status()
    append_result(results, sanitize_provider_status(auth_status))

    IF auth_status.is_valid = FALSE

        IF options.noninteractive = TRUE

            append_result(
                results,
                create_required_interaction_failure(
                    "configure.provider_authentication",
                    remediation_owner = "configure"
                )
            )
            RETURN results

        ENDIF

        explain_authentication_action(
            provider_profile.authentication_method,
            expected_browser_or_device_interaction =
                provider_profile.user_instructions,
            cancellation_method = "choose cancel before authentication"
        )

        confirmation = request_bounded_confirmation(
            prompt_id = "provider.auth.action_required",
            default = "cancel"
        )

        IF confirmation = "cancel"
            RAISE user_cancellation
        ENDIF

        auth_result =
            provider_adapter.start_approved_authentication_flow()
        append_result(results, sanitize_provider_result(auth_result))

        IF auth_result.status = fail
            RETURN results
        ENDIF

        auth_status = provider_adapter.get_authentication_status()
        append_result(results, sanitize_provider_status(auth_status))

        IF auth_status.is_valid = FALSE

            append_result(
                results,
                create_required_failure(
                    "configure.provider_authentication",
                    remediation_owner = "configure"
                )
            )
            RETURN results

        ENDIF

    ENDIF

    account_identity = provider_adapter.get_account_identity(
        provider_profile.account_fields
    )

    identity_validation = validate_minimum_account_identity(
        account_identity,
        provider_profile
    )
    append_result(results, identity_validation)

    IF identity_validation.status = fail
        RETURN results
    ENDIF

    private_commit_identity =
        provider_adapter.derive_private_commit_identity(
            provider_profile.private_commit_identity_rule,
            account_identity
        )

    IF options.noninteractive = TRUE

        display_name = account_identity.user_name

    ELSE

        explain_display_name_choice(
            default_value = account_identity.user_name,
            privacy_note =
                "The display name is public in version-control history."
        )

        display_name = request_validated_display_name(
            default = account_identity.user_name,
            bounded_attempts = manifest.policy.input_attempt_limit
        )

    ENDIF

    append_result(
        results,
        apply_managed_version_control_identity(
            display_name,
            private_commit_identity,
            adapters.version_control,
            redact_complete_identity = TRUE
        )
    )

    RETURN results

ENDPROCEDURE


PROCEDURE execute_validated_settings_merge(
    plan_stage,
    manifest,
    ide_adapter
)

    results = new_result_collection()
    target = plan_stage.planned_items.target

    existing_result = ide_adapter.read_settings(target)
    append_result(results, existing_result)

    IF existing_result.status = fail
        RETURN results
    ENDIF

    IF existing_result.value.is_invalid = TRUE

        diagnostic_result = preserve_sanitized_diagnostic_copy(
            existing_result.value,
            target
        )
        append_result(results, diagnostic_result)

        append_result(
            results,
            create_required_failure(
                "configure.ide_settings.invalid_existing",
                remediation_owner = "technical_support"
            )
        )
        RETURN results

    ENDIF

    merged_settings = merge_only_manifest_declared_keys(
        existing_result.value,
        plan_stage.planned_items.managed_keys
    )

    staged_result = stage_deterministic_settings(
        target,
        merged_settings
    )
    append_result(results, staged_result)

    IF staged_result.status = fail
        RETURN results
    ENDIF

    validation_result = validate_staged_settings(
        staged_result.value,
        plan_stage.planned_items.validation_rules
    )
    append_result(results, validation_result)

    IF validation_result.status = fail
        RETURN results
    ENDIF

    replacement_result = atomically_replace_user_settings(
        target,
        staged_result.value,
        preserve_previous = TRUE
    )
    append_result(results, replacement_result)

    IF replacement_result.status = fail
        RETURN results
    ENDIF

    append_result(
        results,
        verify_managed_setting_keys(
            target,
            plan_stage.planned_items.managed_keys,
            ide_adapter
        )
    )

    RETURN results

ENDPROCEDURE


PROCEDURE post_validate_action(
    run_context,
    platform_facts,
    deployment_profile,
    manifest,
    adapters,
    changed_items
)

    results = new_result_collection()

    append_results(
        results,
        verify_required_system_layer_read_only(
            manifest,
            deployment_profile.platform_id,
            adapters.read_only_capabilities
        )
    )

    append_result(
        results,
        verify_course_folders_preserve_existing_contents(
            run_context,
            manifest
        )
    )

    append_result(
        results,
        verify_user_executable_path_has_one_managed_entry(
            platform_implementation_script_directory()
        )
    )

    append_results(
        results,
        verify_provider_identity_and_authentication(
            manifest.provider_profiles,
            adapters.providers,
            redact_complete_identity = TRUE
        )
    )

    append_results(
        results,
        verify_managed_version_control_settings(
            manifest.managed_settings,
            adapters.version_control
        )
    )

    append_results(
        results,
        verify_required_user_tools_and_extensions(
            manifest,
            deployment_profile.platform_id,
            adapters
        )
    )

    append_results(
        results,
        verify_managed_ide_settings_preserve_unrelated_keys(
            manifest.managed_settings,
            adapters.ide
        )
    )

    append_results(
        results,
        verify_user_integrations(
            manifest,
            deployment_profile,
            adapters.platform
        )
    )

    append_result(
        results,
        confirm_no_system_scope_state_changed(changed_items)
    )

    IF has_no_required_failure(results)
        set_next_step(
            run_context,
            render_matching_lifecycle_command("verify")
        )
    ENDIF

    RETURN results

ENDPROCEDURE


# ==============================================================================
# 5. STANDARD EXIT-CODE RESOLUTION
# ==============================================================================
#
# Precedence is based on safety and remediation value, not numeric order:
#
#     5  Invalid, corrupt, incompatible, or integrity-failed manifest or asset
#     2  Invalid use, unsupported platform, deployment, or OS release
#     3  Required permission or privilege unavailable
#     4  Approved external source or service unavailable after retries
#     7  Partial completion or changed state requiring remediation
#     1  Other required operation or check failure
#     6  Required interactive operation canceled
#     0  All required operations or checks completed successfully
#
# ==============================================================================

PROCEDURE resolve_standard_exit_code(run_summary)

    IF has_manifest_or_integrity_failure(run_summary)
        RETURN 5
    ELSE IF has_unsupported_condition(run_summary)
        RETURN 2
    ELSE IF has_required_privilege_failure(run_summary)
        RETURN 3
    ELSE IF has_exhausted_external_failure(run_summary)
        RETURN 4
    ELSE IF has_partial_completion(run_summary)
        RETURN 7
    ELSE IF has_other_required_failure(run_summary)
        RETURN 1
    ELSE IF has_required_cancellation(run_summary)
        RETURN 6
    ELSE
        RETURN 0
    ENDIF

ENDPROCEDURE


