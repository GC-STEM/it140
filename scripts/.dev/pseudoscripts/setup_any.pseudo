# ==============================================================================
# IT 140 SETUP PSEUDOSCRIPT
# ==============================================================================
#
# Repository path:
#     scripts/.dev/pseudoscripts/setup_any.pseudo
#
# Purpose:
#     Install or repair the manifest-declared system layer and approved
#     system-level course integrations.
#
# Artifact version:
#     0.2.0
#
# Version date:
#     2026-07-29
#
# Development status:
#     Alpha Testing
#
# Version basis:
#     Version 0.1.0 represents the initial pseudoscript baseline.
#     Version 0.2.0 adopts SemVer metadata and manifest schema 2.0.
#
# CVD implementation target:
#     setup_cvd.sh version 2026.07.27.1 (legacy calendar version)
#
# Repository baseline:
#     GC-STEM/it140 commit ffc0c98dc405daff52caa9e61c2f9c5f65b3ebb4
#
# Manifest compatibility:
#     Requires schema_version 2.0, a strict SemVer automation_release,
#     and automation_release_date in YYYY-MM-DD format.
#
# SRS traceability:
#     SET-FR-001 through SET-FR-012
#
# SDD traceability:
#     SET-DES-001 through SET-DES-012
#
# Intended user:
#     A reference-environment administrator or SME using the intended standard
#     desktop account with approved operation-level elevation.
#
# State boundary:
#     SYSTEM_LEVEL
#
# Explicit exclusions:
#     - Provider authentication and Git identity
#     - User-scoped Python tools and IDE extensions
#     - User IDE settings, launchers, panel configuration, and file associations
#     - Student source files, assignment repositories, and Git history
#     - Operating-system release upgrades
#
# Normal next step:
#     Close the terminal, open a new terminal, and run config_<platform>.
#
# ==============================================================================


artifact_version = "0.2.0"
version_date = "2026-07-29"
development_status = "Alpha Testing"
action_id = "setup"
may_change_state = TRUE
lock_required = TRUE
required_options = [
    "help",
    "version",
    "noninteractive",
    "deployment_profile"
]


# ==============================================================================
# 1. MAIN PROCEDURE
# ==============================================================================

PROCEDURE main(arguments)

    options = parse_supported_options_before_logging(arguments, required_options)

    IF options.help_requested
        display_setup_help()
        RETURN 0
    ENDIF

    IF options.version_requested
        display_setup_version(
            artifact_version,
            version_date,
            development_status
        )
        RETURN 0
    ENDIF

    enable_strict_error_handling()
    set_private_default_file_permissions()

    run_context = resolve_setup_paths_and_start_private_transcript(
        filename_pattern = "setup_<platform>_<YYYYMMDD>_<HHMMSS>.log"
    )

    changed = FALSE
    warnings = 0
    temporary_files = []

    INSTALL error handler:
        - report the failing location and log path;
        - clean temporary files;
        - return 7 when managed state changed, otherwise 1.

    INSTALL interruption handler:
        - instruct the user to rerun setup to repair the system layer;
        - clean temporary files;
        - return 7 when managed state changed, otherwise 6.

    DISPLAY opening information:
        script version
        version date
        development status
        current user
        purpose
        log path
    DISPLAY NOTICE that system software may change but personal settings will not

    validate_platform_and_privilege(run_context)
    acquire_shared_mutation_lock(action_id, run_context.platform_id)

    REQUIRE the controlled manifest and schema are readable
    manifest_release = validate_setup_manifest(run_context)
    check_required_free_space(run_context, manifest_release)

    install_or_repair_system_layer(run_context)
    configure_system_integrations(run_context)
    post_validate_system_layer(run_context)

    DISPLAY setup summary:
        result = PASS
        script version
        version date
        development status
        manifest release
        warnings
        failures = 0
        elapsed time
        next step = close terminal, open new terminal, run configure
        log path
        exit code = 0

    DISPLAY closing log and fresh-terminal notices
    CLEAN temporary files
    RETURN 0

ENDPROCEDURE


# ==============================================================================
# 2. PLATFORM AND MANIFEST VALIDATION
# ==============================================================================

PROCEDURE validate_platform_and_privilege(run_context)

    REJECT execution as root or the platform system-administrator account
    REQUIRE the detected operating-system family and release match the
        implementation and deployment profile
    REQUIRE the detected architecture matches the implementation and profile
    REQUIRE the required desktop-management interface is available
    REQUIRE the platform elevation command is available
    REQUIRE approved noninteractive operation-level elevation is available

    IF privilege is unavailable
        DISPLAY ERROR directing the administrator to platform or course support
        RETURN exit code 3
    ENDIF

ENDPROCEDURE


PROCEDURE validate_setup_manifest(run_context)

    RETURN validate_controlled_manifest_pair(
        run_context.manifest_path,
        run_context.schema_path,
        run_context.platform_id,
        run_context.deployment_profile_id,
        required_top_level_keys = [
            "schema_version",
            "automation_release",
            "automation_release_date",
            "policy",
            "platforms",
            "deployment_profiles",
            "managed_settings",
            "managed_assets",
            "logging"
        ]
    )

ENDPROCEDURE


# ==============================================================================
# 3. SYSTEM SOFTWARE
# ==============================================================================

PROCEDURE install_or_repair_system_layer(run_context)

    package_adapter = resolve_manifest_package_adapter(run_context.platform_id)
    required_packages = manifest_required_system_packages(run_context.platform_id)

    REQUIRE required_packages is not empty

    REFRESH native package metadata using the approved retry policy

    INSTALL package-manager trust and retrieval prerequisites

    FOR EACH approved external software source required by the implementation
        RETRIEVE trust material using verified transport and bounded retries
        INSTALL trust material with system-readable permissions
        CREATE or replace the controlled source definition
    ENDFOR

    REFRESH native package metadata using the approved retry policy

    APPLY security and maintenance updates within the current supported
        operating-system release
    NEVER invoke an operating-system release upgrade

    INSTALL or repair all manifest-required system packages
    SET changed = TRUE

ENDPROCEDURE


# ==============================================================================
# 4. SYSTEM INTEGRATIONS
# ==============================================================================

PROCEDURE configure_system_integrations(run_context)

    FOR EACH approved system desktop-startup integration
        WRITE the controlled integration atomically with system ownership
        SET system-readable permissions
        VALIDATE the integration when a validator is available
    ENDFOR

    FOR EACH approved system application policy or managed asset
        WRITE the controlled policy or asset
        SET system ownership and system-readable permissions
        VALIDATE structured content before reporting success
    ENDFOR

    # The tested CVD implementation currently includes:
    #     - an optional Num Lock desktop-startup integration;
    #     - a managed browser bookmark policy for IT 140 resources.

    SET changed = TRUE

ENDPROCEDURE


# ==============================================================================
# 5. POST-VALIDATION
# ==============================================================================

PROCEDURE post_validate_system_layer(run_context)

    failed = FALSE

    FOR EACH manifest-required system package
        REQUIRE the native package database reports it installed
    ENDFOR

    FOR EACH required system capability
        REQUIRE at least one approved executable is discoverable
    ENDFOR

    REQUIRE the required programming-language runtime satisfies its declared
        major and minor version rule

    FOR EACH structured system integration created by setup
        REQUIRE the file exists and passes its format validator
    ENDFOR

    IF any required check fails
        DISPLAY ERROR instructing the administrator to rerun setup
        RETURN exit code 7
    ENDIF

    DISPLAY SUCCESS that system-layer verification passed

ENDPROCEDURE
