# ==============================================================================
# IT 140 PREPARE PSEUDOSCRIPT
# ==============================================================================
#
# Repository path:
#     scripts/.dev/pseudoscripts/prepare_it140.pseudo
#
# Purpose:
#     Retrieve the course automation package and make the matching student
#     lifecycle scripts immediately available from the current terminal.
#
# Artifact version:
#     0.6.0
#
# Version date-time group:
#     2026-08-07-10-44
#
# Development status:
#     Alpha Testing
#
# Version basis:
#     Version 0.1.0 represents the initial pseudoscript baseline.
#     Version 0.2.0 adopts SemVer metadata and a lifecycle transcript.
#     Version 0.4.0 adds the common CVD course-continuity conclusion.
#     Version 0.5.0 adopts minute-resolution version date-time groups and
#     profile-aware lifecycle transition reporting.
#     Version 0.6.0 separates the student repository workspace from the course
#     automation root and defines Configure/Verify workspace integration ownership.
#
# CVD implementation baseline:
#     scripts/cvd/prepare_it140.sh at GC-STEM/it140 commit dbde859f90b1b957b05aa03e25b867563c113bb2
#
# State boundary:
#     PRE_MANIFEST_USER_FILES_AND_SHELL_PATH
#
# Intended user:
#     A student or faculty user following the platform setup instructions.
#
# Important classification:
#     This artifact models the manually copied first-use command set and the
#     later executable package-refresh artifact. It has no manifest dependency
#     or lifecycle lock, but it still provides a compact success or failure
#     conclusion, log path, next step, and profile-aware course-continuity guidance after
#     an unsuccessful run.
#
# Explicit exclusions:
#     - Repository-workspace creation or repair; Configure owns ~/Repos integrations
#     - Recursive inspection or mutation of any repository beneath ~/Repos
#     - Installing, updating, or repairing the operating system or course IDE
#     - Running the administrator install script
#     - Authenticating with a source-code hosting provider
#     - Configuring Git identity, user tools, IDE settings, or desktop launchers
#     - Deleting unrelated files already stored under the course root
#
# SRS traceability:
#     PRE-FR-001 through PRE-FR-015; PKG-FR-021
#
# SDD traceability:
#     PRE-DES-001 through PRE-DES-015; INT-DES-014; ERR-DES-014
#
# Normal next step:
#     Run the exact next step resolved for the deployment profile, starting state, and operating role.
#
# ==============================================================================


# ==============================================================================
# 1. CONTROLLED IMPLEMENTATION VALUES
# ==============================================================================

artifact_version = "0.6.0"
version_date_time_group = "2026-08-07-10-44"
development_status = "Alpha Testing"
platform_id = implementation_platform_id()
course_repository_url = controlled_course_repository_url()
course_root = "${HOME}/it140"
log_directory = course_root + "/logs"
log_path = log_directory + "/prepare_ide_<YYYYMMDD>_<HHMMSS>.log"
temporary_root = create_unique_temporary_directory()
temporary_clone = temporary_root + "/it140"
student_script_directory = course_root + "/scripts/" + platform_id
workflow_context = resolve_bounded_prepare_workflow_context(
    platform_id, detected_deployment_profile(), detected_or_explicit_starting_state(),
    authorized_operating_role()
)
shell_startup_file = platform_primary_interactive_shell_startup_file()
persistent_path_entry = student_script_directory


# ==============================================================================
# 2. BOOTSTRAP COMMAND SET
# ==============================================================================

BEGIN PREPARE

    CREATE course_root if it does not exist
    CREATE log_directory with current-user-only permissions
    START timestamped lifecycle transcript at log_path
    DISPLAY opening information:
        script version
        version date-time group
        development status
        current user
        purpose
        log path

    INSTALL native error and interruption handling that, on any unsuccessful result:
        - preserves the original nonzero status;
        - removes safe temporary data;
        - displays the failed stage and exact log path;
        - calls display_course_continuity_guidance(platform_id);
        - stops the transcript and exits nonzero.

    CREATE temporary_root

    RETRIEVE a shallow snapshot of course_repository_url into temporary_clone

    REMOVE repository metadata from temporary_clone

    COPY all files and directories from temporary_clone into course_root:
        - preserve repository file attributes when supported;
        - replace matching course-automation files with the downloaded copies;
        - do not delete unrelated existing files or directories in course_root.

    REMOVE repository metadata from course_root if present

    REMOVE temporary_root and its contents

    SET executable permission on student lifecycle scripts located directly in:
        student_script_directory

    DEFINE the platform shell PATH statement that prepends:
        student_script_directory

    IF shell_startup_file does not already contain the exact PATH statement
        APPEND one blank line and the PATH statement
    ENDIF

    IF the current shell PATH does not contain student_script_directory
        PREPEND student_script_directory to the current shell PATH
    ENDIF

    REFRESH the current shell command lookup cache

    DISPLAY SUCCESS that the course automation package is ready
    DISPLAY NOTICE with workflow_context.workflow_id
    DISPLAY NOTICE with workflow_context.starting_state_id
    DISPLAY NOTICE with workflow_context.operating_role
    DISPLAY NOTICE with the exact workflow_context.next_step_command
    DISPLAY NOTICE with the log path
    STOP the lifecycle transcript

END PREPARE


# ==============================================================================
# 3. SUCCESSFUL POSTCONDITIONS
# ==============================================================================
#
#     - A private timestamped lifecycle transcript is stored in ${HOME}/it140/logs.
#     - The current repository snapshot is overlaid under ${HOME}/it140.
#     - Neither the downloaded snapshot nor course root is a Git working tree.
#     - Matching student lifecycle scripts are executable.
#     - The matching script directory is available in the current shell PATH.
#     - Future matching interactive shells receive the script directory in PATH.
#     - Existing unrelated course-root content is not intentionally removed.
#
# ==============================================================================
