# ==============================================================================
# IT 140 CONFIGURE PSEUDOSCRIPT
# ==============================================================================
#
# Repository path:
#     scripts/.dev/pseudoscripts/configure_ide.pseudo
#
# Purpose:
#     Configure or repair the intended user's course folders, authentication,
#     identity, user tools, IDE settings, and desktop integrations.
#
# Artifact version:
#     0.2.0
#
# Version date:
#     2026-07-29
#
# Development status:
#     Alpha Testing
#
# Version basis:
#     Version 0.1.0 represents the initial pseudoscript baseline.
#     Version 0.2.0 adopts SemVer metadata and manifest schema 2.0.
#
# CVD implementation target:
#     config_cvd.sh version 2026.07.26.5 (legacy calendar version)
#
# Repository baseline:
#     GC-STEM/it140 commit ffc0c98dc405daff52caa9e61c2f9c5f65b3ebb4
#
# Manifest compatibility:
#     Requires schema_version 2.0, a strict SemVer automation_release,
#     and automation_release_date in YYYY-MM-DD format.
#
# SRS traceability:
#     CFG-FR-001 through CFG-FR-016
#
# SDD traceability:
#     CFG-DES-001 through CFG-DES-016
#
# Intended user:
#     The standard student or faculty account that will complete course work.
#
# State boundary:
#     CURRENT_USER
#
# Explicit exclusions:
#     - System package, repository, policy, and system application changes
#     - Student source files, assignment repositories, and Git history
#     - Secrets or provider credential-store contents
#     - Removal of optional IDE extensions
#     - Removal of unrelated valid user settings
#
# Normal next step:
#     Close the terminal, open a new terminal, and run verify_<platform>.
#
# ==============================================================================


artifact_version = "0.2.0"
version_date = "2026-07-29"
development_status = "Alpha Testing"
action_id = "configure"
may_change_state = TRUE
lock_required = TRUE
required_options = [
    "help",
    "version",
    "noninteractive",
    "deployment_profile"
]


# ==============================================================================
# 1. MAIN PROCEDURE
# ==============================================================================

PROCEDURE main(arguments)

    options = parse_supported_options_before_logging(arguments, required_options)

    IF options.help_requested
        display_configure_help()
        RETURN 0
    ENDIF

    IF options.version_requested
        display_configure_version(
            artifact_version,
            version_date,
            development_status
        )
        RETURN 0
    ENDIF

    enable_strict_error_handling()
    set_private_default_file_permissions()

    run_context = resolve_configure_paths_and_start_private_transcript(
        filename_pattern = "config_<platform>_<YYYYMMDD>_<HHMMSS>.log"
    )

    changed = FALSE
    warnings = 0

    INSTALL error handler:
        - report the failing location and log path;
        - return 7 when managed user state changed, otherwise 1.

    INSTALL interruption handler:
        - instruct the user to rerun configure;
        - return 7 when managed user state changed, otherwise 6.

    DISPLAY opening information:
        script version
        version date
        development status
        current user
        purpose
        log path
    DISPLAY NOTICE that system-wide software will not be changed

    validate_platform_and_user_context(run_context)
    acquire_shared_mutation_lock(action_id, run_context.platform_id)

    REQUIRE the controlled manifest and schema are readable
    manifest_release = validate_configure_manifest(run_context)

    check_required_system_layer(run_context)

    configure_course_folders_path_and_permissions(run_context)
    configure_provider_authentication_and_git_identity(run_context, options)
    configure_user_tools_and_required_extensions(run_context)
    merge_course_managed_ide_settings(run_context)
    configure_user_desktop_integrations(run_context)
    post_validate_user_layer(run_context)

    DISPLAY configuration summary:
        result = PASS
        script version
        version date
        development status
        manifest release
        provider login = valid
        course folder
        course interpreter
        warnings
        failures = 0
        elapsed time
        next step = close terminal, open new terminal, run verify
        log path
        exit code = 0

    DISPLAY closing log and fresh-terminal notices
    RETURN 0

ENDPROCEDURE


# ==============================================================================
# 2. PLATFORM, USER, AND MANIFEST VALIDATION
# ==============================================================================

PROCEDURE validate_platform_and_user_context(run_context)

    REJECT root or system-administrator execution
    REQUIRE operating-system family and release match the implementation
    REQUIRE architecture matches the implementation
    REQUIRE the required desktop-management interface is available

ENDPROCEDURE


PROCEDURE validate_configure_manifest(run_context)

    RETURN validate_controlled_manifest_pair(
        run_context.manifest_path,
        run_context.schema_path,
        run_context.platform_id,
        run_context.deployment_profile_id,
        required_top_level_keys = [
            "schema_version",
            "automation_release",
            "automation_release_date",
            "policy",
            "platforms",
            "deployment_profiles",
            "provider_profiles",
            "managed_settings"
        ]
    )

ENDPROCEDURE


PROCEDURE check_required_system_layer(run_context)

    required_commands = manifest_required_system_executables(run_context.platform_id)
    ADD the exact required programming-language runtime executable

    FOR EACH required command
        IF the command is unavailable
            DISPLAY ERROR directing the user to run update
            IF update already passed
                DISPLAY ERROR directing the user to course support
            ENDIF
            RETURN failure
        ENDIF
    ENDFOR

    DISPLAY SUCCESS that required system components are present

ENDPROCEDURE


# ==============================================================================
# 3. COURSE FOLDERS, PATH, AND SCRIPT PERMISSIONS
# ==============================================================================

PROCEDURE configure_course_folders_path_and_permissions(run_context)

    CREATE OR REPAIR without deleting existing content:
        course root
        private log directory
        matching platform script directory

    SET the log directory to current-user-only permissions

    managed_path_block = exact block that prepends:
        course virtual-environment executable directory
        matching platform script directory

    UPSERT managed_path_block in:
        the user's login-shell startup file
        the user's interactive-shell startup file

    PRESERVE all content outside the exact managed block

    PREPEND both managed directories to the current process PATH when missing
    REFRESH the current process command lookup cache

    SET executable permission on matching student lifecycle scripts in the
        platform script directory

    SET changed = TRUE

ENDPROCEDURE


# ==============================================================================
# 4. PROVIDER AUTHENTICATION AND GIT IDENTITY
# ==============================================================================

PROCEDURE configure_provider_authentication_and_git_identity(run_context, options)

    provider = manifest_required_source_hosting_provider()

    IF provider authentication is not valid
        IF options.noninteractive = TRUE
            DISPLAY ERROR that existing authentication is required
            RETURN exit code 6
        ENDIF

        DISPLAY step-by-step browser authentication instructions
        PROMPT the user to begin or cancel

        IF the user cancels
            RETURN exit code 6 before changes, otherwise 7
        ENDIF

        START provider-owned web authentication using the approved secure flow
        SET changed = TRUE
    ENDIF

    REQUIRE provider authentication is now valid

    provider_account_id = query_authenticated_provider_account_id()
    provider_username = query_authenticated_provider_username()

    VALIDATE provider_account_id and provider_username
    private_commit_identity = derive_provider_private_noreply_identity(
        provider_account_id,
        provider_username
    )

    default_display_name = existing Git display name when nonempty
    OTHERWISE default_display_name = provider_username

    IF options.noninteractive = TRUE
        display_name = default_display_name
    ELSE
        DISPLAY NOTICE that the Git display name is public in version history
        DISPLAY NOTICE that Enter accepts the displayed default
        DISPLAY NOTICE that a different author name may be entered
        PROMPT for display_name using default_display_name
    ENDIF

    VALIDATE display_name:
        - nonempty;
        - no newline characters;
        - within the implementation length limit.

    SET global Git display name to display_name
    SET global Git email to private_commit_identity

    FOR EACH manifest-declared managed Git setting
        SET the global Git setting to the declared value
    ENDFOR

    SET changed = TRUE
    DISPLAY only the public display name, provider username, and a statement that
        the private noreply identity is in use
    NEVER display provider credentials or tokens

ENDPROCEDURE


# ==============================================================================
# 5. USER TOOLS AND REQUIRED IDE EXTENSIONS
# ==============================================================================

PROCEDURE configure_user_tools_and_required_extensions(run_context)

    IF the course virtual environment is not usable
        CREATE it with the exact required system runtime
        SET changed = TRUE
    ENDIF

    required_user_packages = manifest_required_virtual_environment_packages()
    INCLUDE the required code-quality tool when declared as a required capability

    INSTALL only missing required user packages
    PRESERVE other packages in the course virtual environment

    required_extensions = manifest_required_ide_extensions()
    installed_extensions = query_installed_ide_extensions_case_insensitively()

    INSTALL only missing required extensions
    PRESERVE optional and unrelated installed extensions

    SET changed = TRUE when any installation occurs
    DISPLAY SUCCESS for the complete required user-tool layer

ENDPROCEDURE


# ==============================================================================
# 6. COURSE-MANAGED IDE SETTINGS
# ==============================================================================

PROCEDURE merge_course_managed_ide_settings(run_context)

    settings_target = platform_user_ide_settings_file()
    existing_settings = empty object

    IF settings_target exists and is nonempty
        TRY to parse it as a JSON object
        IF parsing fails or the root is not an object
            PRESERVE settings_target unchanged
            WRITE a content-free diagnostic in the private log directory
            DISPLAY ERROR with the diagnostic path
            RETURN failure
        ENDIF
    ENDIF

    managed_settings = manifest_required_ide_settings()
    ADD implementation-required current-user values, including:
        course interpreter path
        course root as default folder
        course testing arguments
        course file-save and whitespace behavior
        platform terminal profile
        course file/editor associations
        local-only settings excluded from settings synchronization

    DEEP-MERGE managed_settings into existing_settings
    PRESERVE unrelated keys and unrelated nested keys

    WRITE the merged object to a temporary sibling file using UTF-8 and LF
    REPARSE the temporary file
    ATOMICALLY replace settings_target
    REMOVE the temporary file

    SET changed = TRUE

ENDPROCEDURE


# ==============================================================================
# 7. USER DESKTOP INTEGRATIONS
# ==============================================================================

PROCEDURE configure_user_desktop_integrations(run_context)

    configure_optional_numlock_convenience(run_context)

    HIDE implementation-selected default desktop icons when required

    CREATE OR REPAIR a trusted desktop launcher for the course folder

    IF the system IDE launcher is available
        COPY it to the user's desktop
        VALIDATE and mark the launcher trusted when supported
    ELSE
        RECORD a warning
    ENDIF

    IF the desktop panel contains the implementation directory-menu component
        SET its base directory to the course root
    ELSE
        RECORD a warning
    ENDIF

    CREATE OR REPAIR a managed IDE panel launcher:
        - reuse the saved plugin identifier only when valid;
        - otherwise allocate a new identifier;
        - store the identifier in a current-user marker file;
        - install the launcher file;
        - place the launcher at the end of the selected panel.

    SET the IDE as default for implementation-selected text and source MIME types

    RELOAD the desktop and panel when supported
    SET changed = TRUE

ENDPROCEDURE


PROCEDURE configure_optional_numlock_convenience(run_context)

    IF the optional Num Lock tool is unavailable
        DISPLAY NOTICE to run update to attempt installation
        DISPLAY NOTICE that course work is unaffected
        RETURN success
    ENDIF

    DETERMINE whether an effective system or user startup entry already enables
        Num Lock

    IF no effective startup entry exists
        CREATE and validate a current-user startup entry
        IF it cannot be created or validated
            DISPLAY NOTICE that course work is unaffected
        ELSE
            SET changed = TRUE
        ENDIF
    ENDIF

    IF no graphical session is active
        DISPLAY NOTICE that the startup preference will apply later when available
    ELSE
        ATTEMPT to enable Num Lock for the current session
        IF the attempt fails
            DISPLAY NOTICE that course work is unaffected
        ENDIF
    ENDIF

    NEVER treat this optional convenience as a required failure

ENDPROCEDURE


# ==============================================================================
# 8. POST-VALIDATION
# ==============================================================================

PROCEDURE post_validate_user_layer(run_context)

    REQUIRE course root, private log directory, and course virtual environment
    REQUIRE exact managed PATH block in both managed shell startup files
    REQUIRE all manifest-required virtual-environment packages
    REQUIRE all manifest-required IDE extensions
    REQUIRE valid provider authentication
    REQUIRE a nonempty Git display name
    REQUIRE the approved provider private noreply Git identity
    REQUIRE all manifest-managed Git settings
    REQUIRE required course-managed IDE settings
    REQUIRE the managed IDE panel launcher record and launcher file
    REQUIRE the matching verify script is present and executable

    IF any required check fails
        DISPLAY ERROR instructing the user to rerun configure
        RETURN exit code 7
    ENDIF

    DISPLAY SUCCESS that user-layer validation passed

ENDPROCEDURE
