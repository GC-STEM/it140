# ==============================================================================
# IT 140 UPDATE PSEUDOSCRIPT
# ==============================================================================
#
# Repository path:
#     scripts/.dev/pseudoscripts/update_it140.pseudo
#
# Purpose:
#     Synchronize approved student automation assets and maintain the supported
#     operating-system release, required tools, extensions, and integrations.
#
# Artifact version: 1.0.1
# Version date-time group: 2026-08-30-07-01
# Development status: Pilot — Active Development
#
# Version basis:
#     Version 0.1.0 represents the initial pseudoscript baseline.
#     Version 0.2.0 adopts SemVer metadata and manifest schema 2.0.
#     Version 0.4.0 adds the common CVD course-continuity conclusion.
#     Version 0.5.0 adopts minute-resolution version date-time groups and
#     profile-aware lifecycle transition reporting.
#     Version 0.6.0 separates the student repository workspace from the course
#     automation root and defines Configure/Verify workspace integration ownership.
#
# CVD implementation target:
#     update_it140.sh version 2026.07.26.6 (legacy calendar version)
#
# Repository baseline:
#     GC-STEM/it140 commit dbde859f90b1b957b05aa03e25b867563c113bb2
#
# Manifest compatibility:
#     Requires schema_version 2.2, a strict SemVer automation_release,
#     and automation_release_date_time_group in YYYY-MM-DD-HH-MM format.
#
# SRS traceability:
#     UPD-FR-001 through UPD-FR-016; PKG-FR-021
#
# SDD traceability:
#     UPD-DES-001 through UPD-DES-016; INT-DES-014; ERR-DES-014
#
# Intended user:
#     The standard student or faculty account during first use, after a reset,
#     or for periodic maintenance.
#
# State boundary:
#     APPROVED_SYSTEM_AND_COURSE_MANAGED_USER_STATE
#
# Explicit exclusions:
#     - Repository-workspace creation or repair; Configure owns ~/Repos integrations
#     - Recursive inspection or mutation of any repository beneath ~/Repos
#     - Operating-system release upgrades
#     - Student source files, assignment repositories, and Git history
#     - Synchronizing or replacing the administrator master/install script
#     - Removing optional IDE extensions
#     - Replacing undeclared user files or settings
#
# Normal next step:
#     Configure when user configuration is incomplete; otherwise verify.
#
# ==============================================================================


artifact_version = "0.6.0"
version_date_time_group = "2026-08-07-10-44"
development_status = "Alpha Testing"
action_id = "update"
update_mode = resolve_update_mode_from_manifest_workflow(
    allowed = ["initial_provider_baseline", "initial_course_master", "periodic_maintenance"]
)
may_change_state = TRUE
lock_required = TRUE
student_scripts_to_synchronize = [
    "config_<platform>",
    "update_<platform>",
    "verify_<platform>"
]
administrator_scripts_to_exclude = [
    "master/setup_<platform>"
]
required_options = [
    "help",
    "version",
    "noninteractive",
    "deployment_profile"
]


# ==============================================================================
# 1. MAIN PROCEDURE
# ==============================================================================

PROCEDURE main(arguments)

    options = parse_supported_options_before_logging(arguments, required_options)

    IF options.help_requested
        display_update_help()
        RETURN 0
    ENDIF

    IF options.version_requested
        display_update_version(
            artifact_version,
            version_date_time_group,
            development_status
        )
        RETURN 0
    ENDIF

    enable_strict_error_handling()
    set_private_default_file_permissions()

    run_context = resolve_update_paths_and_start_private_transcript(
        filename_pattern = "update_<platform>_<YYYYMMDD>_<HHMMSS>.log"
    )

    changed = FALSE
    partial = FALSE
    warnings = 0
    failures = 0
    restart_required = FALSE
    staging_root = NONE

    INSTALL error handler:
        - report the failing location and log path;
        - remove private staging;
        - call display_course_continuity_guidance(run_context);
        - return 7 when managed state changed, otherwise 1.

    INSTALL interruption handler:
        - instruct the user to rerun update for recovery;
        - remove private staging;
        - call display_course_continuity_guidance(run_context);
        - return 7 when managed state changed, otherwise 6.

    INSTALL cleanup handler for private staging

    DISPLAY opening information:
        workflow identifier
        starting state
        operating role
        update mode
        script version
        version date-time group
        development status
        current user
        purpose
        log path
    DISPLAY NOTICE that the operating-system release will not be upgraded
    DISPLAY NOTICE to keep the terminal open until completion

    validate_platform_user_and_privilege(run_context)
    acquire_shared_mutation_lock(action_id, run_context.platform_id)

    REQUIRE the installed manifest and schema are readable
    installed_manifest_release = validate_update_manifest_pair(
        run_context.manifest_path,
        run_context.schema_path
    )

    check_update_prerequisites(run_context)
    detect_existing_user_configuration(run_context)

    synchronize_student_course_assets(run_context)
    update_system_packages(run_context)
    update_required_user_tools_and_extensions(run_context)
    refresh_course_managed_integrations(run_context)
    perform_safe_cleanup(run_context)
    post_validate_update(run_context)
    determine_restart_guidance(run_context)

    exit_code = display_update_summary_and_closing_notices(run_context)

    REMOVE private staging
    RETURN exit_code

ENDPROCEDURE


# ==============================================================================
# 2. PLATFORM, MANIFEST, AND PREREQUISITES
# ==============================================================================

PROCEDURE validate_platform_user_and_privilege(run_context)

    REJECT root or system-administrator execution
    REQUIRE supported operating-system family and release
    REQUIRE supported architecture
    REQUIRE the platform elevation command
    REQUIRE approved noninteractive operation-level elevation

    IF privilege is unavailable
        RETURN exit code 3
    ENDIF

ENDPROCEDURE


PROCEDURE validate_update_manifest_pair(manifest_path, schema_path)

    RETURN validate_controlled_manifest_pair(
        manifest_path,
        schema_path,
        implementation_platform_id(),
        requested_deployment_profile_id(),
        required_top_level_keys = [
            "schema_version",
            "automation_release",
            "automation_release_date_time_group",
            "policy",
            "platforms",
            "deployment_profiles",
            "managed_settings",
            "managed_assets",
            "logging"
        ]
    )

ENDPROCEDURE


PROCEDURE check_update_prerequisites(run_context)

    REQUIRE manifest-declared minimum free space
    REQUIRE repository client, generic runtime, and IDE command required for
        maintenance are available

    IF the IDE is currently running
        DISPLAY NOTICE to close and reopen it after the update
    ENDIF

ENDPROCEDURE


# ==============================================================================
# 3. WORKFLOW DETECTION
# ==============================================================================

PROCEDURE detect_existing_user_configuration(run_context)

    configuration_complete =
        provider authentication is valid
        AND Git display name is nonempty
        AND Git email matches the approved private noreply pattern
        AND exact managed PATH blocks are present
        AND required course-managed IDE settings are valid
        AND managed panel-launcher record and file are valid

    IF configuration_complete
        workflow_name = "Periodic maintenance"
    ELSE
        workflow_name = "First use or reset environment"
        DISPLAY NOTICE that the summary will direct the user to configure
    ENDIF

ENDPROCEDURE


# ==============================================================================
# 4. CONTROLLED COURSE-ASSET SYNCHRONIZATION
# ==============================================================================

PROCEDURE synchronize_student_course_assets(run_context)

    CREATE a private staging directory
    RETRIEVE a shallow course-repository snapshot using bounded retries

    IF retrieval fails
        RETURN exit code 4
    ENDIF

    candidate_manifest = staged controlled manifest
    candidate_schema = staged controlled schema

    REQUIRE both candidate files are readable
    candidate_release = validate_update_manifest_pair(
        candidate_manifest,
        candidate_schema
    )

    ATOMICALLY install candidate_schema, then candidate_manifest:
        - stage in the destination directory;
        - validate structured syntax;
        - preserve a previous copy;
        - activate by atomic replacement;
        - revalidate the active file;
        - restore the previous valid file if activation validation fails.

    FOR EACH target_script IN student_scripts_to_synchronize

        source_script = matching staged student script
        installed_script = matching active student script

        IF source_script is unavailable
            IF installed_script exists and passes script syntax validation
                PRESERVE installed_script
                DISPLAY NOTICE that this release omitted the script
            ELSE
                RECORD required failure
                SET partial = TRUE
            ENDIF
            CONTINUE
        ENDIF

        candidate_version = read_script_version(source_script)
        REQUIRE candidate_version is a numeric dotted version

        installed_version = read_script_version(installed_script) when present

        IF installed_version is valid AND candidate_version is older
            PRESERVE the newer installed script
            DISPLAY NOTICE that downgrade was prevented
            CONTINUE
        ENDIF

        IF installed_version exists but is invalid
            DISPLAY NOTICE that it will be replaced
        ENDIF

        ATOMICALLY install source_script with executable permissions:
            - validate script syntax before activation;
            - preserve a previous copy;
            - revalidate after activation;
            - restore the previous valid file on failure.

    ENDFOR

    NEVER retrieve, synchronize, preserve, compare, or install any path in
        administrator_scripts_to_exclude as part of the student update workflow

    active_manifest_release = validate_update_manifest_pair(
        active manifest,
        active schema
    )

    REMOVE private staging
    DISPLAY SUCCESS that course-managed student assets are active

ENDPROCEDURE


# ==============================================================================
# 5. SYSTEM MAINTENANCE
# ==============================================================================

PROCEDURE update_system_packages(run_context)

    REFRESH native package metadata using the manifest retry policy

    IF metadata refresh fails after bounded retries
        RETURN exit code 4
    ENDIF

    APPLY security and maintenance updates within the current supported release
    NEVER invoke an operating-system release upgrade

    INSTALL or repair all manifest-required system packages
    SET changed = TRUE

    optional_convenience_package = manifest_optional_numlock_package_when_declared()

    IF optional_convenience_package is declared
        ATTEMPT to install or repair it
        IF the attempt fails
            DISPLAY NOTICE that course work is unaffected
        ELSE
            SET changed = TRUE
        ENDIF
    ENDIF

ENDPROCEDURE


# ==============================================================================
# 6. USER TOOLS AND EXTENSIONS
# ==============================================================================

PROCEDURE update_required_user_tools_and_extensions(run_context)

    IF course virtual environment is missing
        CREATE it with the exact required system runtime
        IF workflow is periodic maintenance
            RECORD warning that a missing environment was repaired
        ELSE
            DISPLAY first-use notice
        ENDIF
        SET changed = TRUE
    ENDIF

    UPGRADE the package installer inside the course virtual environment
    UPGRADE all manifest-required course packages
    SET changed = TRUE

    ATTEMPT to update all installed IDE extensions
    PRESERVE optional extensions
    IF any installed extension update fails
        RECORD warning
        SET partial = TRUE
    ENDIF

    FOR EACH manifest-required IDE extension
        FORCE install or update the extension
        IF the required extension cannot be installed
            RECORD warning
            SET partial = TRUE
        ENDIF
    ENDFOR

    SET changed = TRUE

ENDPROCEDURE


# ==============================================================================
# 7. COURSE-MANAGED INTEGRATIONS
# ==============================================================================

PROCEDURE refresh_course_managed_integrations(run_context)

    configure_optional_numlock_for_update(run_context)

    IF the system IDE launcher exists
        REFRESH the user's IDE desktop launcher

        IF a valid managed panel-launcher identifier exists
            REFRESH its launcher file
        ELSE IF user configuration is complete
            RECORD warning that the managed panel record is missing
        ELSE
            DISPLAY NOTICE that configure will create the panel launcher
        ENDIF

        RELOAD the desktop when supported
        SET changed = TRUE
    ELSE
        RECORD warning
        SET partial = TRUE
    ENDIF

    IF the user IDE settings file exists
        TRY to parse it as a JSON object
        DEEP-MERGE only current manifest-managed IDE settings plus current
            interpreter and course-root paths
        WRITE, validate, and atomically replace the file
        PRESERVE unrelated settings
        IF refresh fails
            PRESERVE the existing settings
            RECORD warning
            SET partial = TRUE
        ELSE
            SET changed = TRUE
        ENDIF
    ENDIF

ENDPROCEDURE


PROCEDURE configure_optional_numlock_for_update(run_context)

    IF optional Num Lock tool is unavailable
        DISPLAY NOTICE that course work is unaffected
        RETURN success
    ENDIF

    BUILD and validate the approved startup entry in private temporary storage

    ATTEMPT to install or repair the system startup entry using approved
        noninteractive elevation

    IF the system entry cannot be installed
        DISPLAY NOTICE that a user fallback will be attempted
    ENDIF

    IF a user entry already overrides the system entry OR no valid system entry
        INSTALL or repair the current-user startup entry
    ENDIF

    ATTEMPT to enable Num Lock in the current graphical session
    DISPLAY only nonblocking notices when unavailable or unsuccessful

    NEVER set partial or failure solely because this optional convenience failed

ENDPROCEDURE


# ==============================================================================
# 8. SAFE CLEANUP AND POST-VALIDATION
# ==============================================================================

PROCEDURE perform_safe_cleanup(run_context)

    DISPLAY the manifest-declared obsolete-component plan

    IF no obsolete components are declared
        REMOVE only package-manager dependencies proven unused
        CLEAN only safe package-manager caches
    ELSE
        REMOVE only explicitly manifest-declared obsolete managed components
    ENDIF

    RUN the native package dependency-consistency check
    SET changed = TRUE

ENDPROCEDURE


PROCEDURE post_validate_update(run_context)

    VALIDATE the active manifest and schema

    REQUIRE every manifest-required system package
    REQUIRE every manifest-required virtual-environment package
    REQUIRE every manifest-required IDE extension
    REQUIRE every required system command
    REQUIRE active student scripts and controlled assets remain valid

    IF any required check fails
        RECORD required failure
        SET partial = TRUE
    ELSE
        DISPLAY SUCCESS that required updated state passed validation
    ENDIF

ENDPROCEDURE


# ==============================================================================
# 9. RESTART AND SUMMARY GUIDANCE
# ==============================================================================

PROCEDURE determine_restart_guidance(run_context)

    IF the platform indicates a restart is required
        restart_required = TRUE
        DISPLAY NOTICE to save work and use the platform VM or system restart
            control
    ELSE
        restart_required = FALSE
        DISPLAY NOTICE to close this terminal and open a new terminal
    ENDIF

ENDPROCEDURE


PROCEDURE display_update_summary_and_closing_notices(run_context)

    IF partial = TRUE OR failures > 0
        result = PARTIAL
        exit_code = 7
        next_script = update
    ELSE
        result = PASS
        exit_code = 0
        IF user configuration is complete
            next_script = verify
        ELSE
            next_script = configure
        ENDIF
    ENDIF

    COMBINE next_script with restart_required to produce exact next-step guidance

    DISPLAY:
        result
        workflow name
        script version
        version date-time group
        development status
        active manifest release
        warnings
        failures
        restart required
        elapsed time
        next step
        log path
        exit code

    IF exit_code is nonzero
        CALL display_course_continuity_guidance(run_context)
    ENDIF

    DISPLAY closing log and fresh-terminal notices
    RETURN exit_code

ENDPROCEDURE


# WORKFLOW MODE RULES
# - initial_provider_baseline updates the provider image within the current OS release,
#   then names install_it140.<ext> as the next step.
# - initial_course_master applies approved course-master maintenance, never performs
#   Install responsibilities, and names configure_it140.<ext> as the next step.
# - periodic_maintenance maintains an initialized environment and recommends Verify
#   when restart, change, warning, or policy requires it.
