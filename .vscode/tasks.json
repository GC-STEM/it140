{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Core: Install CI Dependencies",
      "detail": "Install the pinned dependencies required by Core validation.",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "-m",
        "pip",
        "install",
        "--disable-pip-version-check",
        "-r",
        "${workspaceFolder}/.github/ci/requirements.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Core: Validate Repository",
      "detail": "Validate required Core files, configuration, and EoL policies.",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.github/ci/check_repository.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
